---
// Background.astro
---
<canvas id="sine-bg"></canvas>

<style>
  #sine-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }
  html:not(.dark) #sine-bg {
    opacity: .4;
  }
</style>

<script>
  const canvas = document.getElementById('sine-bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;
  const STEP = 2;
  let sumBuf = new Float32Array(0);

  function resize() {
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);
    sumBuf = new Float32Array(Math.ceil(W / STEP) + 2);
  }
  resize();
  window.addEventListener('resize', resize);

  const waves = [
    { freq: 0.008, amp:  76, speed: 0.18, phase: 0.0, boost: 1, opacity: 0.32, width: 1.2, k: 1, rank: 0, hue: 0 },
    { freq: 0.013, amp:  44, speed: 0.28, phase: 2.1, boost: 1, opacity: 0.26, width: 0.8, k: 1, rank: 0, hue: 0 },
    { freq: 0.021, amp:  24, speed: 0.42, phase: 4.2, boost: 1, opacity: 0.22, width: 1.6, k: 1, rank: 0, hue: 0 },
    { freq: 0.005, amp: 110, speed: 0.10, phase: 4.4, boost: 1, opacity: 0.20, width: 0.6, k: 1, rank: 0, hue: 0 },
    { freq: 0.020, amp:  28, speed: 0.42, phase: 1.3, boost: 1, opacity: 0.18, width: 0.5, k: 1, rank: 0, hue: 0 },
    { freq: 0.031, amp:  16, speed: 0.60, phase: 3.7, boost: 1, opacity: 0.18, width: 2.0, k: 1, rank: 0, hue: 0 },
    { freq: 0.004, amp: 140, speed: 0.07, phase: 0.8, boost: 1, opacity: 0.22, width: 0.7, k: 1, rank: 0, hue: 0 },
    { freq: 0.017, amp:  36, speed: 0.35, phase: 5.1, boost: 1, opacity: 0.22, width: 0.9, k: 1, rank: 0, hue: 0 },
    { freq: 0.025, amp:  60, speed: 0.22, phase: 1.8, boost: 1, opacity: 0.16, width: 0.4, k: 1, rank: 0, hue: 0 },
    { freq: 0.040, amp:  12, speed: 0.75, phase: 0.4, boost: 1, opacity: 0.16, width: 2.4, k: 1, rank: 0, hue: 0 },
    { freq: 0.003, amp: 180, speed: 0.05, phase: 3.2, boost: 1, opacity: 0.22, width: 1.0, k: 1, rank: 0, hue: 0 },
    { freq: 0.005, amp: 180, speed: 0.30, phase: 2.5, boost: 1, opacity: 0.18, width: 0.7, k: 1, rank: 0, hue: 0 },
  ];
  const N = waves.length;

  // ── Square-wave easter egg ──────────────────────────────────────────
  //   square(θ) = (4/π) Σ sin(kθ)/k,  k = 1, 3, 5, ...
  // Waves are ranked by frequency: the slowest becomes the fundamental (k=1),
  // the next k=3, etc. Harmonics are absorbed in that order as scrolling
  // speeds up, so the partial sums are real Fourier partial sums.
  // Each harmonic also gets a prism hue (red = fundamental → violet = highest).
  [...waves.keys()]
    .sort((a, b) => waves[a].freq - waves[b].freq)
    .forEach((idx, rank) => {
      waves[idx].rank = rank;
      waves[idx].k = 2 * rank + 1;
      waves[idx].hue = 5 + (rank / (N - 1)) * 270;
    });

  const F0 = 0.005;              // fundamental spatial frequency (rad/px)
  const SPEED0 = 0.22;           // fundamental travel speed (rad/s)
  const PLATEAU = 120;           // square wave plateau height (px)
  const TARGET_SCROLL = 0.001;   // how much scroll slides the square wave
  const harmonicAmp = (k: number) => (PLATEAU * 4 / Math.PI) / k;

  // scroll speed → target level (0..1) → spring → how many harmonics are absorbed
  const SPEED_START = 9;        // px/frame where the first harmonic joins
  const SPEED_FULL  = 50;        // px/frame where all 12 are absorbed
  const HOLD = 0.98;             // scroll-speed decay per frame (higher = holds longer)
  const STIFFNESS = 50;          // spring stiffness
  const DAMPING = 5;             // spring damping (lower = more ringing)
  const DT = 0.016;

  window.addEventListener('timeline-item', (e: Event) => {
    const { index } = (e as CustomEvent).detail;
    waves[index % waves.length].boost = 3.5;
  });

  let scrollY = window.scrollY;
  window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

  let lastScrollY = scrollY;
  let scrollSpeed = 0;
  let lvl = 0, vel = 0;          // spring state

  const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
    };
    return [f(0) * 255, f(8) * 255, f(4) * 255];
  }

  let t = 0;

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // scroll speed: fast attack, slow decay (the "hold")
    const dy = Math.abs(scrollY - lastScrollY);
    lastScrollY = scrollY;
    scrollSpeed = dy > scrollSpeed
      ? scrollSpeed + (dy - scrollSpeed) * 0.3
      : scrollSpeed * HOLD;
    const target = clamp01((scrollSpeed - SPEED_START) / (SPEED_FULL - SPEED_START));

    // underdamped spring: overshoots on the way up, rings down on release
    vel += (STIFFNESS * (target - lvl) - DAMPING * vel) * DT;
    lvl += vel * DT;
    if (target === 0 && Math.abs(lvl) < 0.0005 && Math.abs(vel) < 0.002) { lvl = 0; vel = 0; }

    const n = clamp01(lvl) * N;   // number of harmonics currently absorbed (fractional)

    const isDark = document.documentElement.classList.contains('dark');
    const baseR = isDark ? 100 : 15;
    const baseG = isDark ? 160 : 60;
    const baseB = isDark ? 220 : 140;

    const scrollInfluence = scrollY * 0.004;
    const targetPhase = t * SPEED0 + scrollY * TARGET_SCROLL;
    const yBase = H * 0.5;
    const nPts = Math.floor(W / STEP) + 1;
    const anyMerging = n > 0.01;
    if (anyMerging) sumBuf.fill(0, 0, nPts);
    let sumE = 0;

    waves.forEach((wave) => {
      const boost = wave.boost;
      const t2 = Math.min((boost - 1) / 2.5, 1);

      // this wave's own absorption amount
      const a = clamp01(n - wave.rank);
      const e = a * a * (3 - 2 * a);
      sumE += e;

      // color: base blue → timeline pulse color → this harmonic's prism hue
      const [hr, hg, hb] = hslToRgb(wave.hue, 0.85, isDark ? 0.66 : 0.42);
      const br = baseR + (100 - baseR) * t2;
      const bg = baseG + (160 - baseG) * t2;
      const bb = baseB + (220 - baseB) * t2;
      const wr = Math.round(br + (hr - br) * e);
      const wg = Math.round(bg + (hg - bg) * e);
      const wb = Math.round(bb + (hb - bb) * e);

      // brightest mid-transition, then dims as it's absorbed into the sum
      const glowUp = 1 + 0.7 * Math.sin(Math.PI * e);
      const boostedOpacity = wave.opacity * Math.min(boost, 2.5) * glowUp * (1 - 0.6 * e);

      const hAmp = harmonicAmp(wave.k);
      const ampNow = wave.amp + (hAmp - wave.amp) * e;
      const boostedAmp = ampNow * boost;
      const wobble = 1 - e;

      ctx.beginPath();
      for (let j = 0; j < nPts; j++) {
        const x = j * STEP;

        const thetaOrig = x * wave.freq + wave.phase + t * wave.speed + scrollInfluence;
        let theta = thetaOrig;
        if (e > 0.001) {
          const thetaHarm = wave.k * (x * F0 + targetPhase);
          theta = thetaOrig + (thetaHarm - thetaOrig) * e;
          sumBuf[j] += e * hAmp * Math.sin(thetaHarm);
        }

        const y = yBase
          + Math.sin(theta) * boostedAmp
          + Math.sin(x * wave.freq * 0.5 + scrollInfluence * 0.7) * boostedAmp * 0.3 * wobble;
        j === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }

      if (boost > 1.1) {
        ctx.strokeStyle = `rgba(100,160,220,${(boost - 1) * 0.06})`;
        ctx.lineWidth = wave.width * 6;
        ctx.stroke();
      }

      ctx.strokeStyle = `rgba(${wr},${wg},${wb},${boostedOpacity})`;
      ctx.lineWidth = wave.width * (boost > 1 ? 1.5 : 1);
      ctx.stroke();

      if (wave.boost > 1) wave.boost = Math.max(1, wave.boost - 0.018);
    });

    // the partial sum of whatever has been absorbed so far
    if (anyMerging && sumE > 0.01) {
      ctx.beginPath();
      for (let j = 0; j < nPts; j++) {
        const y = yBase + sumBuf[j];
        j === 0 ? ctx.moveTo(0, y) : ctx.lineTo(j * STEP, y);
      }

      // colors converge: tinted while few harmonics are in, "white" once all are
      const white = clamp01(sumE / N);
      const sr = Math.round(isDark ? 150 + 95 * white : 10);
      const sg = Math.round(isDark ? 205 + 40 * white : 50);
      const sb = Math.round(isDark ? 255 : 130);
      const alpha = clamp01(sumE / 1.5);

      ctx.strokeStyle = `rgba(${sr},${sg},${sb},${alpha * 0.18})`;
      ctx.lineWidth = 10;
      ctx.stroke();

      ctx.strokeStyle = `rgba(${sr},${sg},${sb},${alpha * 0.9})`;
      ctx.lineWidth = 2.2;
      ctx.stroke();
    }

    t += DT;
    requestAnimationFrame(draw);
  }

  draw();
</script>
