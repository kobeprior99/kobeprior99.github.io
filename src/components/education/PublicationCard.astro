---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: string;
  image?: string;
  link?: string;
}
const { title, authors, venue, year, image, link } = Astro.props;
const Tag = link ? "a" : "div";
---
<Tag class="pub-card" {...(link ? { href: link, target: "_blank", rel: "noopener" } : {})}>
  {image && (
    <div class="pub-image">
      <img src={image} alt={`${title} thumbnail`} loading="lazy" />
    </div>
  )}
  <div class="pub-body">
    <h4>{title}</h4>
    <p class="pub-authors">{authors}</p>
    <p class="pub-venue">{venue} · {year}</p>
  </div>
  {link && <span class="pub-arrow">↗</span>}
</Tag>

<style>
  .pub-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--glass-bg, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    border-radius: 14px;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  a.pub-card:hover {
    transform: translateX(4px);
    border-color: var(--color-accent);
  }
  .pub-image {
    flex-shrink: 0;
    width: 72px;
    height: 96px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
  }
  .pub-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pub-body h4 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }
  .pub-authors {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.75;
  }
  .pub-venue {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    opacity: 0.6;
    font-style: italic;
  }
  .pub-arrow {
    margin-left: auto;
    opacity: 0.5;
    font-size: 1.2rem;
  }
</style>