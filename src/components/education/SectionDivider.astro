---
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;
---
<div class:list={["divider", { flip }]}>
  <svg viewBox="0 0 400 24" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 12 Q 25 0, 50 12 T 100 12 T 150 12 T 200 12 T 250 12 T 300 12 T 350 12 T 400 12"
      fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</div>

<style>
  .divider {
    width: 100%;
    max-width: 400px;
    margin: 3rem auto;
    opacity: 0.5;
  }
  .divider.flip {
    transform: scaleY(-1);
  }
  .divider svg {
    width: 100%;
    height: 24px;
    display: block;
  }
</style>