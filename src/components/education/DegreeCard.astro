---
interface Props {
  degree: string;
  institution: string;
  dates: string;
  image?: string;
  gpa?: string;
  details?: string[];
}
const { degree, institution, dates, image, gpa, details = [] } = Astro.props;
---
<article class="degree-card">
  {image && (
    <div class="degree-image">
      <img src={image} alt={`${institution} crest`} loading="lazy" />
    </div>
  )}
  <div class="degree-body">
    <span class="degree-dates">{dates}</span>
    <h3>{degree}</h3>
    <p class="degree-institution">{institution}</p>
    {gpa && <p class="degree-gpa">GPA: {gpa}</p>}
    {details.length > 0 && (
      <ul class="degree-details">
        {details.map((d) => <li>{d}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .degree-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--glass-bg, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.1));
    backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 1.75rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .degree-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .degree-image {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .degree-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .degree-dates {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .degree-body h3 {
    margin: 0.25rem 0 0.15rem;
    font-size: 1.25rem;
  }
  .degree-institution {
    margin: 0;
    opacity: 0.75;
    font-size: 0.95rem;
  }
  .degree-gpa {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    opacity: 0.7;
  }
  .degree-details {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  @media (max-width: 576px) {
    .degree-card {
      flex-direction: column;
    }
  }
</style>